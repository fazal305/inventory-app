APP_ENV=local
APP_DEBUG=true

# mysql (default) or pgsql. Postgres support exists only because some
# deployment targets offer managed Postgres but not managed MySQL — MySQL
# is the project's primary, fully-documented database (see README/docs/SECURITY.md).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=inventory_api
DB_USER=root
DB_PASS=

# Comma-separated list of origins allowed to call this API from a browser (see CORS, Phase 8).
# http://localhost:5173 is the frontend/ Vite dev server (see ../frontend/client/vite.config.js).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Bearer token lifetime in seconds. 604800 = 7 days.
TOKEN_TTL_SECONDS=604800
