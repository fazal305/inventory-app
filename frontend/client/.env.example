# Optional. Overrides the base URL the Assets page uses to call backend/
# (the merged inventory-api). Leave unset for local dev — Vite proxies
# /backend-api to BACKEND_API_TARGET (default http://127.0.0.1:8000; see
# vite.config.js) and rewrites it to backend/'s /api/v1 prefix.
#
# Set this for a production build, since frontend/ and backend/ are
# typically deployed separately and there is no dev proxy in a static build.
# VITE_BACKEND_API_URL=https://api.example.com/api/v1
